# Copy to .env for local Compose use. In Dockhand, add these in the stack's
# environment-variable panel instead. Never commit the real .env file.

TZ=America/Los_Angeles

# Parent directory for the standalone stack's persistent data. The stack
# continues using the legacy mailposture folders so an upgrade reuses existing data.
ROOT=/srv/docker-data

# Image published by this repository's GitHub Actions workflow.
DOMAINPOSTURE_IMAGE=ghcr.io/your-github-username/domainposture:latest

# Optional Discord webhook fallback. It can also be saved securely in Settings.
DOMAINPOSTURE_DISCORD_WEBHOOK=

# Domains, DKIM selectors, TLS endpoints, report history, refresh interval,
# request timeout, and the OpenSearch on/off switch are managed in the web UI.

# Optional SMTP safety controls. The per-MX cooldown is also available under
# Settings > General > Monitoring behavior.
# SMTP_PROBE_COOLDOWN_MINUTES=30
# SMTP_PROBE_CONCURRENCY=2
# SMTP_PROBE_BACKOFF_MINUTES=15
# SMTP_PROBE_MAX_BACKOFF_MINUTES=240

MONITORING_NETWORK=monitoring
PROXY_NETWORK=proxy

OPENSEARCH_URL=http://parsedmarc-opensearch:9200
OPENSEARCH_INDEX=dmarc_aggregate*
OPENSEARCH_FAILURE_INDEX=dmarc_failure*,dmarc_forensic*
OPENSEARCH_SMTP_TLS_INDEX=smtp_tls*
OPENSEARCH_USERNAME=admin
OPENSEARCH_VERIFY_TLS=false

# Secret when OpenSearch is enabled: enter this in Dockhand as a secret variable.
OPENSEARCH_PASSWORD=replace-with-your-opensearch-admin-password

# Required by compose.standalone.yml. Use the same strong value for the
# bundled OpenSearch service and DomainPosture's connection.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional image-version overrides for the standalone stack.
OPENSEARCH_VERSION=2
PARSEDMARC_VERSION=latest
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# Optional named volumes used by standalone runtime diagnostics and service logs.
PARSEDMARC_STATUS_VOLUME=mailposture_parsedmarc_status
OPENSEARCH_LOG_VOLUME=mailposture_opensearch_logs

# Optional migration/path overrides. Enter absolute host paths in Dockhand; do
# not include another variable in their values.
# DOMAINPOSTURE_SETTINGS_PATH=/srv/docker-data/mailposture
# OPENSEARCH_DATA_PATH=/srv/docker-data/parsedmarc/opensearch/data
# OPENSEARCH_SNAPSHOT_PATH=/srv/docker-data/parsedmarc/opensearch/snapshots

# Optional: override the named Docker volume used for /data. The legacy default
# intentionally preserves existing MailPosture settings and certificate state.
DOMAINPOSTURE_DATA_VOLUME=mailposture_data

# Deprecated compatibility fallbacks remain supported during migration:
# MAILPOSTURE_IMAGE, MAILPOSTURE_DISCORD_WEBHOOK, MAILPOSTURE_SETTINGS_PATH,
# and MAILPOSTURE_DATA_VOLUME.
